#include "nuAnaConfig.fcl"
#include "simulationservices_dune.fcl"
#include "services_refactored_pdune.fcl"
#include "protodune_tools_dune.fcl"

process_name: nuAnalysis

source:
{
  module_type: RootInput
  maxEvents:   -1
}

services:
{
  TFileService: { fileName: "nuValidation.root" }
  TimeTracker:  {}
  @table::protodunehd_simulation_services
  @table::protodunehd_reco_services
  BackTrackerService: @local::standard_backtrackerservice
  ParticleInventoryService: @local::standard_particleinventoryservice
}

physics:
{
  analyzers:
  {
    nuValidation: @local::nuValidationConfig
  }

  ana: [ nuValidation ]
  end_paths: [ ana ]
}