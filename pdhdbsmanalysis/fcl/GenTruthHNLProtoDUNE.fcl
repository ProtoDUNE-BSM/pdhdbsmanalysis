BEGIN_PROLOG

analyzeGenHNL:
{
  module_type: "GenTruthHNLProtoDUNE"
  
  MCTruthLabel: "generator" # For HNL decay signals
  CosmicLabel: "cosmicgenerator" # For cosmic background genetared by CORSIKA
