#include "services_refactored_pdune.fcl"
#include "protodune_tools_dune.fcl"
#include "tools_dune.fcl"

process_name: OfflineTriggerTPCInfo

services:
{
  TFileService: { fileName: "LArSoftTriggerTPC_hist.root" }
  TimeTracker:       @local::dune_time_tracker
  MemoryTracker:     @local::dune_memory_tracker
  RandomNumberGenerator: {} #ART native random number generator
  message:              @local::dune_message_services_prod
  #@table::protodunehd_reco_services
  @table::protodunevd_refactored_simulation_services
  IFDH: {}
}

source:
{
  module_type: RootInput
  maxEvents: -1        # Number of events to create
  saveMemoryObjectThreshold: 0
}

physics:
{

 analyzers:
 {
     GeneralProtoDUNETriggerTrainingDataMaker:
     {
         module_type: GeneralProtoDUNETriggerTrainingDataMaker
         tp_tag: "tpmakerTPC"
         ta_tag: "tamakerTPC"
         tc_tag: "tcmakerTPC"
         verbosity: 1
         MCTruthLabel: "generator"
     }
 }

 ana:       [ GeneralProtoDUNETriggerTrainingDataMaker ]

}


